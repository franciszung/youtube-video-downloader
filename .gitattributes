# 仓库内统一用 LF 存储与检出，避免 Windows / Linux 混编时的噪音 diff
* text=auto eol=lf

# Windows 批处理 / PowerShell 脚本必须用 CRLF
# cmd.exe 对 LF 换行的 .bat 支持不稳，PowerShell 脚本同理会告警
*.bat text eol=crlf
*.ps1 text eol=crlf

# 二进制不做任何换行转换
*.exe binary
*.dll binary
*.pyd binary
*.zip binary
*.jpg binary
*.jpeg binary
*.png binary
*.webp binary
*.mp4 binary
